rules_version = '2';

// Копирай в Firebase Console → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myFamily() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId;
    }

    // всеки променя само своя профил; вижда своя и тези от своето семейство
    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || resource.data.familyId == myFamily());
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // групата се чете по код (за присъединяване), създава се от логнат потребител
    match /families/{familyId} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      // всеки, който се присъедини, може да се добави в списъка с членове
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
    }

    // задачите са видими само за членовете на същото семейство
    match /todos/{todoId} {
      allow read, delete: if signedIn() && resource.data.familyId == myFamily();

      // възложена задача отмята и приема само човекът, на когото е;
      // другите могат да я редактират или да я възложат на друг
      allow update: if signedIn() && resource.data.familyId == myFamily()
        && (
          resource.data.get('assignee', null) == null
          || resource.data.assignee == request.auth.uid
          || (
            // не пипат отметката, а „приета“ могат само да нулират (при ново възлагане)
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['done', 'doneByEmail', 'doneAt'])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accepted'])
              || request.resource.data.accepted == false
              || request.resource.data.get('assignee', null) == request.auth.uid  // поемаш я сам
            )
          )
        );
      allow create: if signedIn() && request.resource.data.familyId == myFamily();

      // коментари към задача: виждат ги и пишат само хората от семейството
      match /comments/{commentId} {
        function sameFamily() {
          return get(/databases/$(database)/documents/todos/$(todoId)).data.familyId == myFamily();
        }
        allow read: if signedIn() && sameFamily();
        allow create: if signedIn() && sameFamily() && request.resource.data.from == request.auth.uid;
        allow delete: if signedIn() && resource.data.from == request.auth.uid;
      }
    }
  }
}
